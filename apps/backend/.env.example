# העתיקו קובץ זה ל-.env ומלאו ערכים אמיתיים. .env עצמו לא נכנס ל-git.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/benefits_wallet?schema=public"
PORT=4000
NODE_ENV=development
LOG_LEVEL=info
# comma-separated ברשימה אמיתית, * לפיתוח בלבד
CORS_ORIGINS=*

# הגנת הדשבורד — סיסמה יחידה, בלי הרשמה ובלי "שכחתי סיסמה".
# חובה לשנות בסביבה אמיתית; בלעדיה כל פעולת ניהול נחסמת (503).
ADMIN_PASSWORD=
# מפתח לחתימת עוגיית ההתחברות — כל מחרוזת אקראית וארוכה. חובה
# לשנות בסביבה אמיתית.
SESSION_SECRET=change-this-to-a-long-random-string

# התראות מייל על בעיות בסריקה. אם ריקים, ההתראה נכתבת ללוג בלבד.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ADMIN_ALERT_EMAIL=admin@example.com

# ניקוי כפילויות/פריטים יתומים ע"י AI (Google Gemini, gemini-3.1-flash-lite).
# ריק = שלב שיפוט הכפילויות מדלג (נרשם ללוג בלבד) — ניקוי הריצות
# היתומות הדטרמיניסטי ממשיך לעבוד גם בלי מפתח. חיפוש לוגו אוטומטי
# (modules/logoSearch) דורש בנוסף Cloud Billing מקושר לפרויקט
# Google Cloud של המפתח הזה — ראו lib/gemini.ts.
GEMINI_API_KEY=

# אחסון תמונות ב-Cloudflare R2 (lib/r2Storage.ts) — כולם חובה, בשונה
# מ-GEMINI_API_KEY: בלי R2 אין למה להוריד תמונות בזרימת הקליטה בכלל.
# R2_ENDPOINT: https://<ACCOUNT_ID>.r2.cloudflarestorage.com (בלי שם
# ה-bucket בסוף). R2_PUBLIC_URL: כתובת ציבורית לקריאה בפועל — דורש
# הפעלת "Public Development URL" (r2.dev) או custom domain בהגדרות
# ה-bucket בדשבורד Cloudflare; לא נוצר אוטומטית עם ה-bucket עצמו.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_URL=
